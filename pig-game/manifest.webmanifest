{
  "id": "/pig-game/",
  "name": "Pig Game Track App",
  "short_name": "Pig Game",
  "description": "Sound effects and music tracks for the Pig Game",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#a21caf",
  "theme_color": "#f8b4c0",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "entertainment",
    "music",
    "games"
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "lang": "en",
  "dir": "ltr"
}
